# Python
__pycache__/
*.pyc
venv/
.venv/

# 生成データ (インデックス・プレビュー・切り抜き)
data/
clips/

# 入力動画 (サイズが大きいため各自配置)
video/

# 共有用インデックス (文字起こしなどの個人情報を含む可能性がある)
exports/

# ローカル設定・認証情報
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
*.vindex.zip
benchmark-results/

# Local source-only UI snapshots (never include user media or indexes)
.ui-backups/

# OS
Thumbs.db
.DS_Store
*.lnk
.claude/settings.local.json

# OAuth client bundled into a distributed copy of CUT (do not publish)
youtube_oauth_client.json

# App-local binaries (e.g. an ffmpeg build matching the GPU driver)
tools/

# 配信者の写真・GB素材・計測用の音声 (配布物に含めない)
reference/
_haas_bench/
.claude/*.tgz
# 配信から作った生成物・個人の試行スクリプト
docs/digests/
assets/otomad/
.claude/try_finish_one.py
